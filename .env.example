GEMINI_API_KEY=your_google_ai_studio_key
PEXELS_API_KEY=your_pexels_api_key
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
FAL_KEY=your_fal_ai_key
ADMIN_MASTER_KEY=VOKALOOM-ADMIN-2026
VIP_CLIENT_CODES=VOKALOOM-PRO-2026,CLIENT-VIP-01
NEXT_PUBLIC_CHECKOUT_URL_COP=https://checkout.wompi.co/l/your_60000_cop_link
NEXT_PUBLIC_CHECKOUT_URL_USD=https://buy.stripe.com/your_15_usd_link

# Optional: Shared Redis/KV REST store for durable rate limiting & guest trial tracking across instances
# Supports UPSTASH_REDIS_REST_URL/TOKEN, KV_REST_API_URL/TOKEN, or RATE_LIMIT_REDIS_REST_URL/TOKEN
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional: Reverse-proxy IP trust ("true"/"1" behind Nginx/ALB, or set VERCEL/CF_PAGES/FLY_APP_NAME)
# TRUST_PROXY=false

# Production Budget Caps, Fair-Use Limits & Circuit Breakers
# Set HARD_CAP_* to e.g. 1 during local testing to lock paid calls strictly to 1 run; leave empty/unset for unlimited
# HARD_CAP_IMAGE_LIMIT=1
# HARD_CAP_AUDIO_LIMIT=1
# HARD_CAP_VISION_LIMIT=1
# HARD_CAP_WINDOW=lifetime # "lifetime" | "24h" | "30d" (defaults to "lifetime" in dev, "24h" in prod)
# DISABLE_PAID_MODEL_FALLBACK=true # defaults to "true" when any HARD_CAP_* is set
# LOW_QUOTA_WARN_RATIO=0.2
# FAL_LOW_BALANCE_WARN_USD=5.0
# FAL_MIN_BALANCE_USD=1.0
# PRO_CLIENT_DAILY_IMAGE_LIMIT=25
# PRO_CLIENT_DAILY_AUDIO_LIMIT=100
# PAID_AI_EMERGENCY_PAUSE=false
# BUDGET_REQUIRE_DURABLE_STORE=false
